@model (IEnumerable<Library_Management.Models.BookListViewModel> books, IEnumerable<Library_Management.Models.AuthorListViewModel> authors)

@{
    ViewData["Title"] = "Archive";
}

<h2>Archived Books</h2>
<table class="table table-striped">
    <thead><tr><th>Title</th><th>Author</th><th></th></tr></thead>
    <tbody>
    @foreach (var b in Model.books)
    {
        <tr>
            <td>@b.Title</td>
            <td>@b.AuthorName</td>
            <td>
                <form asp-action="RestoreBook" asp-controller="Archive" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@b.BookId" />
                    <button type="submit" class="btn btn-sm btn-success">Restore</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

<h2 class="mt-4">Archived Authors</h2>
<table class="table table-striped">
    <thead><tr><th>Name</th><th>Books</th><th></th></tr></thead>
    <tbody>
    @foreach (var a in Model.authors)
    {
        <tr>
            <td>@a.Name</td>
            <td>@a.BooksCount</td>
            <td>
                <form asp-action="RestoreAuthor" asp-controller="Archive" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@a.Id" />
                    <button type="submit" class="btn btn-sm btn-success">Restore</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
