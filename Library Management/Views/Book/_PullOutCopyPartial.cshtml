@{
    var bookId = (Guid)ViewBag.BookId;
    var copyId = (Guid)ViewBag.CopyId;
}
<form asp-action="PullOutCopy" asp-controller="Book" method="post" id="pullOutCopyForm">
    <div class="modal-header">
        <h5 class="modal-title">Pull-out Copy</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <input type="hidden" name="bookId" value="@bookId" />
        <input type="hidden" name="copyId" value="@copyId" />
        <div class="mb-3">
            <label class="form-label">Reason</label>
            <select name="reason" class="form-select" required>
                <option value="">-- Select reason --</option>
                <option>Damaged</option>
                <option>Lost</option>
                <option>Outdated</option>
                <option>Other</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Additional details (optional)</label>
            <input type="text" name="details" class="form-control" placeholder="Notes" />
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-warning">Confirm Pull-out</button>
    </div>
</form>
<script>
    document.getElementById('pullOutCopyForm').addEventListener('submit', function (e) {
        // merge reason + details before submit
        const sel = this.querySelector('select[name="reason"]');
        const details = this.querySelector('input[name="details"]').value;
        if (details) sel.value = sel.value + (sel.value ? ' - ' : '') + details;
    });
</script>
