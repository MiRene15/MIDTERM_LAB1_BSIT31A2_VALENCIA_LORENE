@model Library_Management.Models.EditAuthorViewModel
<form asp-action="Edit" asp-controller="Author" method="post" id="editAuthorForm">
    <div class="modal-header">
        <h5 class="modal-title">Edit Author</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Biography" class="form-label"></label>
            <textarea asp-for="Biography" class="form-control"></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="BirthDate" class="form-label"></label>
            <input asp-for="BirthDate" type="date" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="ProfileImageUrl" class="form-label"></label>
            <input asp-for="ProfileImageUrl" class="form-control" />
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
