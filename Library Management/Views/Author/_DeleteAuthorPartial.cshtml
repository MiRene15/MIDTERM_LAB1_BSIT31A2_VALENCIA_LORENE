@model Library_Management.Models.AuthorListViewModel
<div class="modal-header">
    <h5 class="modal-title">Delete Author</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <p>Are you sure you want to delete <strong>@Model.Name</strong>?</p>
</div>
<div class="modal-footer">
    <form id="deleteAuthorForm" asp-action="Delete" asp-controller="Author" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </form>
</div>
